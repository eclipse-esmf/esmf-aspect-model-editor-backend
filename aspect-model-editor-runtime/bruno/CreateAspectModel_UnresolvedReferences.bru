meta {
  name: CreateAspectModel_UnresolvedReferences
  type: http
  seq: 93
}

post {
  url: http://localhost:{{port}}/ame/api/models
  body: text
  auth: none
}

headers {
  aspect-model-urn: urn:samm:org.eclipse.examples:1.0.0#AspectWithUnresolvedReference
  file-name: AspectWithUnresolvedReference.ttl
  Content-Type: text/plain
}

body:text {
  @prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
  @prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
  @prefix missing: <urn:samm:org.eclipse.esmf.missing:1.0.0#> .
  @prefix : <urn:samm:org.eclipse.examples:1.0.0#> .
  
  :AspectWithUnresolvedReference a samm:Aspect ;
     samm:properties ( :resolvableProperty missing:missingProperty ) ;
     samm:operations ( ) .
  
  :resolvableProperty a samm:Property ;
     samm:characteristic missing:MissingCharacteristic .
}

tests {
  test("Status code is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("Error response names the missing elements like the validation", function() {
    const error = res.getBody().error;
    expect(error.unresolvedElements).to.deep.equal([
      "urn:samm:org.eclipse.esmf.missing:1.0.0#MissingCharacteristic",
      "urn:samm:org.eclipse.esmf.missing:1.0.0#missingProperty"
    ]);
    expect(error.message).to.include("Element 'urn:samm:org.eclipse.esmf.missing:1.0.0#MissingCharacteristic' does not exist in a file.");
    expect(error.message).to.not.include("File does not exist");
  });
}
