meta {
  name: CorsPreflight_DeleteNamespace
  type: http
  seq: 96
}

options {
  url: http://localhost:{{port}}/ame/api/models/namespace?namespace=org.eclipse.bruno.referenced&version=1.0.0
  body: none
  auth: none
}

headers {
  Origin: http://localhost:4200
  Access-Control-Request-Method: DELETE
}

tests {
  test("The browser preflight without custom headers is allowed", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("The UI origin and DELETE are allowed", function() {
    expect(res.getHeader("access-control-allow-origin")).to.equal("http://localhost:4200");
    expect(res.getHeader("access-control-allow-methods")).to.contain("DELETE");
  });
}
