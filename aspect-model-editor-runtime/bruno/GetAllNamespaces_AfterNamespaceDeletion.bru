meta {
  name: GetAllNamespaces_AfterNamespaceDeletion
  type: http
  seq: 85
}

get {
  url: http://localhost:{{port}}/ame/api/models/namespaces
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Both deleted namespaces are gone", function() {
    const namespaces = Object.keys(res.getBody());
    expect(namespaces).to.not.include("org.eclipse.bruno.referenced");
    expect(namespaces).to.not.include("org.eclipse.bruno.referencing");
  });
}
