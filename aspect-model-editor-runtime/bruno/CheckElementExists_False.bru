meta {
  name: CheckElementExists_False
  type: http
  seq: 38
}

get {
  url: http://localhost:{{port}}/ame/api/models/check-element?fileName=Movement.ttl
  body: none
  auth: none
}

headers {
  aspect-model-urn: urn:samm:org.eclipse.examples:1.0.0#Movement
