meta {
  name: GetModelsBatch_NotFound
  type: http
  seq: 35
}

post {
  url: http://localhost:{{port}}/ame/api/models/batch
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  [
    {
      "key": "org.eclipse.examples:1.0.0:NonExistent.ttl",
      "fileName": "NonExistent.ttl",
      "aspectModelUrn": "urn:samm:org.eclipse.examples:1.0.0#NonExistent",
