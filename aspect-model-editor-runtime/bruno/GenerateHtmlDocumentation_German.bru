meta {
  name: GenerateHtmlDocumentation_German
  type: http
  seq: 40
}

post {
  url: http://localhost:{{port}}/ame/api/generate/documentation?language=de
  body: multipartForm
  auth: none
}

headers {
  uri: blob://movement.ttl
}

body:multipart-form {
  aspectModel: @file(./TestingFiles/Movement.ttl)
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Content type is text/html", function() {
    expect(res.getHeader('content-type')).to.include("text/html");
  });
}
