meta {
  name: GetReferences_File_OnlyOutgoingReferences
  type: http
  seq: 73
}

get {
  url: http://localhost:{{port}}/ame/api/models/references?namespace=org.eclipse.bruno.referencing&version=1.0.0&fileName=Consumer.ttl
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Using other models does not block the deletion", function() {
    expect(res.getBody().deletable).to.equal(true);
    expect(res.getBody().references).to.be.empty;
  });
}
